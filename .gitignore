# 依赖
node_modules/

# 构建产物
dist/
dist_electron/
out/
build/

# 运行时数据
server/uploads/
server/database.sqlite
server/database.backup_*.sqlite
dbtmp_*

# 自测临时产物（Puppeteer userDataDir / 临时脚本与截图）
# 注意：下面这几条是「自测临时产物」规则，会连带命中同名的需求验收图，
# 故对归档目录下真正需要随仓库走的需求截图做精准豁免（否则换机会丢失 roadmap 引用的验收参考）。
_chrome_*/
_pptr_*/
_*.cjs
_*.png
_*.txt
!docs/archive/req-screenshots/*.png

# 日志
*.log
npm-debug.log*

# 环境变量
.env
.env.local

# 系统与编辑器
.DS_Store
Thumbs.db
.vscode/
.idea/

# 文档 PDF 不入库
docs/*.pdf

# 临时下载/备份（不入库）
attachments_download/
server/backup_empty/

# 迁移前自动备份（G4：与库同目录保留最近 3 份）——备份内含真实业务数据，绝不入库
server/database.sqlite.bak-*

# UI 渲染取证脚手架（本机诊断用，不入库）：用项目自带 Electron 真渲染 + 逐像素扫描，
# 用于无法靠肉眼看图时定位视觉问题（如「黑影」到底由谁绘制）。保留在本地复用。
uiprobe-*.cjs
.uiprobe/
