{
  "name": "golden-shuttle",
  "private": true,
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "dev:server": "cross-env ELECTRON_RUN_AS_NODE=1 electron server/index.cjs",
    "dev:client": "vite",
    "dev:all": "node scripts/dev.cjs",
    "lint": "eslint src server scripts tests main.js preload.js vitest.config.mjs",
    "doc:check": "node scripts/doc-stats.cjs --check",
    "test": "npm run test:unit && npm run test:rollback && npm run test:security",
    "test:unit": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run",
    "test:rollback": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/test-rollback-size.cjs",
    "test:security": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/test-upload-security.cjs",
    "build": "vite build",
    "electron:start": "cross-env NODE_ENV=development concurrently \"npm run dev:client\" \"wait-on http://localhost:5173 && electron .\"",
    "rebuild:node": "npm rebuild better-sqlite3",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "sample:db": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/make-sample-db.cjs",
    "build:exe": "npm run rebuild:electron && npm run build && electron-builder"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.6",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "fs-extra": "^11.3.3",
    "lucide-react": "^0.575.0",
    "pdfjs-dist": "^3.11.174",
    "pdfmake": "^0.3.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^34.2.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.3.1",
    "vitest": "^3.2.7",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.patternmaster.app",
    "productName": "PatternMaster Pro",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "!server/database.sqlite",
      "!server/database.sqlite.bak-*",
      "!server/database.backup_*.sqlite",
      "!server/uploads",
      "!server/uploads/**",
      "!server/seed",
      "!server/seed/**",
      "!server/backup_empty",
      "!server/backup_empty/**",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "server/seed/database.sqlite",
        "to": "server/database.sqlite"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
